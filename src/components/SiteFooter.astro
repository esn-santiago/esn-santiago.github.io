---
import { getDictionary, langPrefix, defaultLang, type LanguageCode } from '../i18n';
import { socialIcons as icons, socialLinks as socials } from '../data/socials';

const { lang = defaultLang } = Astro.props as { lang?: LanguageCode };
const dict = getDictionary(lang);
const { footer } = dict.home;
const prefix = langPrefix(lang);
const path = (slug: string) => `${prefix}/${slug}`;
---

<footer class="site-footer site-container" style="display:flex;justify-content:space-between;align-items:flex-end;gap:48px;padding:56px 0 40px;">
  <div style="flex:0 0 auto;">
    <div style="display:flex;align-items:center;gap:10px;margin:0 0 12px;">
      <img src="/favicon-32x32.png" alt="" width="24" height="24" style="display:block;" />
      <strong style="font-size:1.1rem;font-weight:900;letter-spacing:.04em;">ESN Santiago de Compostela</strong>
    </div>
    <p style="margin:0;font-size:.85rem;line-height:1.6;opacity:.65;">{footer.tagline}<br />{footer.address}</p>
  </div>

  <div class="footer-right" style="display:flex;flex-direction:column;align-items:flex-end;gap:28px;">
    <nav aria-label="Social">
      <ul style="display:flex;align-items:center;justify-content:flex-end;gap:10px;margin:0;padding:0;list-style:none;">
        {socials.map((social) => (
          <li style="margin:0;padding:0;">
            <a
              href={social.href}
              target={social.href.startsWith('http') ? '_blank' : undefined}
              rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              aria-label={`${social.name} — ${footer.opensInNewTab}`}
              title={social.name}
              style={`width:46px;height:46px;display:inline-flex;align-items:center;justify-content:center;color:inherit;text-decoration:none;border:1.5px solid currentColor;border-radius:50%;opacity:.8;transition:all .2s ease;`}
              onmouseover={`this.style.background='${social.hoverBg}';this.style.borderColor='${social.hoverBorder}';this.style.color='${social.hoverColor}';this.style.transform='translateY(-4px)';this.style.opacity='1'`}
              onmouseout="this.style.background='transparent';this.style.borderColor='currentColor';this.style.color='inherit';this.style.transform='translateY(0)';this.style.opacity='.8'"
              onfocus={`this.style.background='${social.hoverBg}';this.style.borderColor='${social.hoverBorder}';this.style.color='${social.hoverColor}';this.style.opacity='1'`}
              onblur="this.style.background='transparent';this.style.borderColor='currentColor';this.style.color='inherit';this.style.opacity='.8'"
              set:html={icons[social.name]}
            />
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-label={footer.legal[0]} style="display:flex;flex-wrap:wrap;justify-content:flex-end;gap:8px 20px;">
      {[
        [path('avisolegal'), footer.legal[0]],
        [path('politicaprivacidad'), footer.legal[1]],
        [path('TyC'), footer.legal[2]],
        [path('metodos-de-pago'), footer.legal[3]],
      ].map(([href, label]) => (
        <a
          href={href}
          style="color:inherit;font-size:.7rem;font-weight:700;letter-spacing:.04em;text-decoration:none;opacity:.55;transition:color .2s ease,opacity .2s ease;"
          onmouseover="this.style.color='#ec008c';this.style.opacity='1'"
          onmouseout="this.style.color='inherit';this.style.opacity='.55'"
          onfocus="this.style.color='#ec008c';this.style.opacity='1'"
          onblur="this.style.color='inherit';this.style.opacity='.55'"
        >
          {label}
        </a>
      ))}
    </nav>
  </div>
</footer>

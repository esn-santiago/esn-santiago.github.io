---
import { getDictionary, langPrefix, defaultLang, type LanguageCode } from '../i18n';

const { lang = defaultLang } = Astro.props as { lang?: LanguageCode };
const dict = getDictionary(lang);
const { home } = dict;
const prefix = langPrefix(lang);
const path = (slug: string) => `${prefix}/${slug}`;

const icons = {
  Flickr: '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><circle cx="7.5" cy="12" r="3.5"/><circle cx="16.5" cy="12" r="3.5"/></svg>',
  Instagram: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5"/><circle cx="12" cy="12" r="4.1"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg>',
  Facebook: '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M13.7 21v-8h2.7l.4-3.1h-3.1v-2c0-.9.3-1.5 1.6-1.5h1.7V3.6c-.3 0-1.3-.1-2.4-.1-2.4 0-4.1 1.5-4.1 4.2v2.3H8v3.1h2.5v8h3.2Z"/></svg>',
  X: '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M4 4h4.2l4.1 5.5L17 4h3l-6.3 7.2L20.5 20h-4.2l-4.5-6-5.1 6h-3l6.9-7.8L4 4Zm3.4 1.8 9.8 12.4h1.8L9.2 5.8H7.4Z"/></svg>',
  LinkedIn: '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><rect x="3.5" y="8.5" width="3.4" height="11.5" rx=".3"/><circle cx="5.2" cy="5.2" r="1.7"/><path d="M10.2 8.5V20h3.4v-6.2c0-1.7.3-3.2 2.4-3.2 2 0 2.1 1.7 2.1 3.3V20h3.4v-6.8c0-3.4-.7-6-4.7-6-1.9 0-3.1 1-3.6 1.9h-.1V8.5h-2.9Z"/></svg>',
  TikTok: '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M14.2 3.5h3.1c.3 1.9 1.2 3.4 3.1 4.3v3.2a9 9 0 0 1-3.1-1.2v5.5a5.7 5.7 0 1 1-5.7-5.7c.4 0 .8 0 1.2.1v3.2a2.7 2.7 0 1 0 1.4 2.4V3.5Z"/></svg>',
} as const;

const socials = [
  { name: 'Flickr', href: 'https://www.flickr.com/photos/people/esnsantiago/', hoverBg: 'linear-gradient(135deg,#ff0084 50%,#0063dc 50%)', hoverColor: '#fff', hoverBorder: 'transparent' },
  { name: 'Instagram', href: 'https://www.instagram.com/esn_santiagodecompostela/?hl=es', hoverBg: 'linear-gradient(135deg,#833ab4 0%,#fd1d1d 50%,#fcb045 100%)', hoverColor: '#ffffff', hoverBorder: 'transparent' },
  { name: 'Facebook', href: 'https://www.facebook.com/esnsantiagodecompostela/', hoverBg: '#1877F2', hoverColor: '#fff', hoverBorder: 'transparent' },
  { name: 'X', href: 'https://x.com/esn_santiago', hoverBg: '#000000', hoverColor: '#ffffff', hoverBorder: 'transparent' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/company/esn-santiagodecompostela', hoverBg: '#0A66C2', hoverColor: '#fff', hoverBorder: 'transparent' },
  { name: 'TikTok', href: 'https://www.tiktok.com/@esn.santiagodecompostela?is_from_webapp=1&sender_device=pc', hoverBg: '#010101', hoverColor: '#25F4EE', hoverBorder: '#25F4EE' },
] as const satisfies { name: keyof typeof icons; href: string; hoverBg: string; hoverColor: string; hoverBorder: string }[];
---

<main class="home-container">
  <section class="hero">
    <div class="hero-highlight">
      <div class="hero-highlight-inner home-container">
        <div class="hero-labels">
          <div class="hero-label"><span class="hero-dot"></span>SANTIAGO DE COMPOSTELA</div>
          <div class="hero-label"><span class="hero-dot"></span>LUGO</div>
        </div>

        <h1>{home.heroTitle[0]}<br /><span>{home.heroTitle[1]}</span><br />{home.heroTitle[2]}</h1>

        <div class="hero-bottom">
          <p>{home.heroText}</p>
          <div class="hero-actions">
            <a href={path('eventos')} class="brutalist-button button-dark">{home.heroCtaEvents}</a>
            <a href={path('que-es-esn')} class="text-link">{home.heroCtaAbout}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="stats">
    {home.committees.map((committee) => (
      <div class="stat"><strong>{committee}</strong></div>
    ))}
  </section>

  <section id="about" class="section">
    <div class="two-columns">
      <h2>{home.about.heading[0]}<br />{home.about.heading[1]}</h2>
      <div class="section-text">
        <p class="large-text">{home.about.leadBefore}<strong>{home.about.leadStrong}</strong>{home.about.leadAfter}</p>
        <p>{home.about.paragraphs[0]}</p>
        <p>{home.about.paragraphs[1]}</p>
      </div>
    </div>
  </section>

  <section id="activities" class="section">
    <div class="section-header">
      <h2>{home.activities.heading[0]}<br />{home.activities.heading[1]}</h2>
    </div>
    <div class="card-grid">
      {home.activities.cards.map((card, index) => (
        <article class="brutalist-card">
          <div class="card-icon">{card.icon}</div>
          <div class="card-number">0{index + 1}</div>
          <h3>{card.title}</h3>
          <p>{card.text}</p>
          <a href={path(card.href)}>{card.cta}</a>
        </article>
      ))}
    </div>
  </section>

  <section id="events" class="section">
    <div class="events-header">
      <h2>{home.events.heading[0]}<br />{home.events.heading[1]}</h2>
      <a href={path('eventos')} class="text-link">{home.events.viewAll}</a>
    </div>
    <div class="events-list">
      {home.events.items.map((item) => (
        <article class="event-row">
          <div class="event-date"><span>{item.month}</span><strong>{item.day}</strong></div>
          <div class="event-info">
            <span class="event-category">{item.category}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
          <div class="event-location">📍 {item.location}</div>
          <a href={path('eventos')} class="event-arrow" aria-label={item.title}>↗</a>
        </article>
      ))}
    </div>
  </section>

  <section id="join" class="join-section">
    <div class="join-content">
      <h2>{home.join.heading}<br /><strong>{home.join.emphasis}</strong></h2>
      <p>{home.join.text}</p>
      <a href={path('contacto')} class="brutalist-button button-pink">{home.join.cta}</a>
    </div>
    <div class="join-decoration" aria-hidden="true"><span>ESN</span><span>SANTIAGO</span></div>
  </section>

  <section id="contact" class="contact-section">
    <div>
      <h2>{home.contact.heading}</h2>
      <p>{home.contact.text}</p>
    </div>
    <div class="contact-links">
      <a href="https://www.instagram.com/esn_santiagodecompostela/?hl=es" target="_blank" rel="noopener noreferrer">{home.contact.instagram} <span>↗</span></a>
      <a href="mailto:junta@esn-santiago.org">{home.contact.email} <span>↗</span></a>
      <a href={path('esncard')}>{home.contact.esncard} <span>↗</span></a>
    </div>
  </section>

  <footer class="site-footer" style="display:flex;justify-content:space-between;align-items:flex-end;gap:48px;padding:56px 0 40px;">
    <div style="flex:0 0 auto;">
      <div style="display:flex;align-items:center;gap:10px;margin:0 0 12px;">
        <img src="/favicon-32x32.png" alt="" width="24" height="24" style="display:block;" />
        <strong style="font-size:1.1rem;font-weight:900;letter-spacing:.04em;">ESN Santiago de Compostela</strong>
      </div>
      <p style="margin:0;font-size:.85rem;line-height:1.6;opacity:.65;">{home.footer.tagline}<br />{home.footer.address}</p>
    </div>

    <div class="footer-right" style="display:flex;flex-direction:column;align-items:flex-end;gap:28px;">
      <nav aria-label="Social">
        <ul style="display:flex;align-items:center;justify-content:flex-end;gap:10px;margin:0;padding:0;list-style:none;">
          {socials.map((social) => (
            <li style="margin:0;padding:0;">
              <a
                href={social.href}
                target={social.href.startsWith('http') ? '_blank' : undefined}
                rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                aria-label={`${social.name} — ${home.footer.opensInNewTab}`}
                title={social.name}
                style={`width:46px;height:46px;display:inline-flex;align-items:center;justify-content:center;color:inherit;text-decoration:none;border:1.5px solid currentColor;border-radius:50%;opacity:.8;transition:all .2s ease;`}
                onmouseover={`this.style.background='${social.hoverBg}';this.style.borderColor='${social.hoverBorder}';this.style.color='${social.hoverColor}';this.style.transform='translateY(-4px)';this.style.opacity='1'`}
                onmouseout="this.style.background='transparent';this.style.borderColor='currentColor';this.style.color='inherit';this.style.transform='translateY(0)';this.style.opacity='.8'"
                onfocus={`this.style.background='${social.hoverBg}';this.style.borderColor='${social.hoverBorder}';this.style.color='${social.hoverColor}';this.style.opacity='1'`}
                onblur="this.style.background='transparent';this.style.borderColor='currentColor';this.style.color='inherit';this.style.opacity='.8'"
                set:html={icons[social.name]}
              />
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={home.footer.legal[0]} style="display:flex;flex-wrap:wrap;justify-content:flex-end;gap:8px 20px;">
        {[
          [path('avisolegal'), home.footer.legal[0]],
          [path('politicaprivacidad'), home.footer.legal[1]],
          [path('TyC'), home.footer.legal[2]],
          [path('metodos-de-pago'), home.footer.legal[3]],
        ].map(([href, label]) => (
          <a
            href={href}
            style="color:inherit;font-size:.7rem;font-weight:700;letter-spacing:.04em;text-decoration:none;opacity:.55;transition:color .2s ease,opacity .2s ease;"
            onmouseover="this.style.color='#ec008c';this.style.opacity='1'"
            onmouseout="this.style.color='inherit';this.style.opacity='.55'"
            onfocus="this.style.color='#ec008c';this.style.opacity='1'"
            onblur="this.style.color='inherit';this.style.opacity='.55'"
          >
            {label}
          </a>
        ))}
      </nav>
    </div>
  </footer>
</main>

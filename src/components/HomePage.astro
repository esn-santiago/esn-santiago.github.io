---
import type { LanguageCode } from '../data/site';

const { lang } = Astro.props as { lang: LanguageCode };
const content = {
  es: ['SANTIAGO DE COMPOSTELA · GALICIA', 'ESN Santiago de Compostela conecta estudiantes internacionales y locales a través de experiencias, voluntariado, cultura y comunidad.', 'Una comunidad sin fronteras.', 'Descubre ESN.', 'Próximos eventos.', 'No seas un espectador.', 'Un espacio para todos.', '¿Hablamos?'],
  en: ['SANTIAGO DE COMPOSTELA · GALICIA', 'ESN Santiago de Compostela connects international and local students through experiences, volunteering, culture and community.', 'A community without borders.', 'Discover ESN.', 'Upcoming events.', 'Do not be a spectator.', 'A space for everyone.', 'Shall we talk?'],
  gl: ['SANTIAGO DE COMPOSTELA · GALICIA', 'ESN Santiago de Compostela conecta estudantes internacionais e locais a través de experiencias, voluntariado, cultura e comunidade.', 'Unha comunidade sen fronteiras.', 'Descubre ESN.', 'Próximos eventos.', 'Non sexas un espectador.', 'Un espazo para todos.', 'Falamos?'],
  fr: ['SAINT-JACQUES-DE-COMPOSTELLE · GALICE', 'ESN Santiago de Compostela relie les étudiants internationaux et locaux grâce à des expériences, du bénévolat, de la culture et une communauté.', 'Une communauté sans frontières.', 'Découvre ESN.', 'Prochains événements.', 'Ne reste pas spectateur.', 'Un espace pour tous.', 'On se parle ?'],
  de: ['SANTIAGO DE COMPOSTELA · GALICIEN', 'ESN Santiago de Compostela verbindet internationale und lokale Studierende durch Erlebnisse, Freiwilligenarbeit, Kultur und Gemeinschaft.', 'Eine Gemeinschaft ohne Grenzen.', 'Entdecke ESN.', 'Kommende Veranstaltungen.', 'Sei nicht nur Zuschauer.', 'Ein Ort für alle.', 'Sprechen wir?'],
  pt: ['SANTIAGO DE COMPOSTELA · GALIZA', 'A ESN Santiago de Compostela liga estudantes internacionais e locais através de experiências, voluntariado, cultura e comunidade.', 'Uma comunidade sem fronteiras.', 'Descobre a ESN.', 'Próximos eventos.', 'Não sejas um espectador.', 'Um espaço para todos.', 'Falamos?'],
  it: ['SANTIAGO DE COMPOSTELA · GALIZIA', 'ESN Santiago de Compostela mette in contatto studenti internazionali e locali attraverso esperienze, volontariato, cultura e comunità.', 'Una comunità senza confini.', 'Scopri ESN.', 'Prossimi eventi.', 'Non essere uno spettatore.', 'Uno spazio per tutti.', 'Parliamo?'],
} as const;
const t = content[lang];
const eventLink = `/${lang}/eventos`;
---

<main class="site-container">
  <section class="hero"><div class="hero-label"><span class="hero-dot"></span>{t[0]}</div><h1>Connect.<br /><span>Discover.</span><br />Experience.</h1><div class="hero-bottom"><p>{t[1]}</p><div class="hero-actions"><a href={eventLink} class="brutalist-button button-pink">EVENTS →</a><a href={`/${lang}/que-es-esn`} class="text-link">ESN →</a></div></div><div class="hero-color-blocks" aria-hidden="true"><span></span><span></span><span></span><span></span></div></section>
  <section class="stats"><div class="stat"><strong>ESN</strong><span>International Community</span></div><div class="stat"><strong>🌍</strong><span>International students</span></div><div class="stat"><strong>🤝</strong><span>Volunteering and community</span></div><div class="stat"><strong>📍</strong><span>Santiago de Compostela</span></div></section>
  <section class="section"><div class="section-header"><div class="section-number">01 / ESN</div><h2>{t[2]}</h2></div><div class="two-columns"><div></div><div class="section-text"><p class="large-text">Erasmus Student Network is an international network created by and for students.</p><p>{t[1]}</p></div></div></section>
  <section class="section"><div class="section-header"><div class="section-number">02 / ESN</div><h2>{t[3]}</h2></div><div class="card-grid">{[['🌍', 'International'], ['🎉', 'Events'], ['🤝', 'Volunteering']].map(([icon, title], index) => <article class="brutalist-card"><div class="card-icon">{icon}</div><div class="card-number">0{index + 1}</div><h3>{title}</h3><p>{t[1]}</p><a href={`/${lang}/que-es-esn`}>Discover →</a></article>)}</div></section>
  <section class="section"><div class="section-header events-header"><div><div class="section-number">03 / AGENDA</div><h2>{t[4]}</h2></div><a href={eventLink} class="text-link">View all →</a></div><div class="events-list">{[['SEP', '01', 'Welcome Event'], ['OCT', '10', 'Cultural Exchange'], ['OCT', '24', 'Discover Galicia']].map(([month, date, title]) => <article class="event-row"><div class="event-date"><span>{month}</span><strong>{date}</strong></div><div class="event-info"><span class="event-category">EVENT</span><h3>{title}</h3><p>{t[1]}</p></div><div class="event-location">📍 Santiago</div><a href={eventLink} class="event-arrow" aria-label={title}>↗</a></article>)}</div></section>
  <section class="join-section"><div class="join-content"><div class="section-number">04 / ESN</div><h2>{t[5]}</h2><p>{t[1]}</p><a href={`/${lang}/contacto`} class="brutalist-button button-pink">JOIN ESN →</a></div><div class="join-decoration"><span>ESN</span><span>SANTIAGO</span></div></section>
  <section class="languages"><div><span class="section-number">05 / LANGUAGES</span><h2>{t[6]}</h2></div><div class="language-list"><a href="/es/">Español</a><a href="/en/">English</a><a href="/gl/">Galego</a><a href="/fr/">Français</a><a href="/de/">Deutsch</a><a href="/pt/">Português</a><a href="/it/">Italiano</a></div></section>
  <section class="contact-section"><div><div class="section-number">06 / CONTACT</div><h2>{t[7]}</h2><p>{t[1]}</p></div><div class="contact-links"><a href="#">Instagram <span>↗</span></a><a href="#">Email <span>↗</span></a><a href={`/${lang}/esncard`}>ESNcard <span>↗</span></a></div></section>
  <footer class="site-footer"><div><strong>ESN SANTIAGO</strong><p>Erasmus Student Network<br />Santiago de Compostela · Galicia</p></div><div class="footer-right">Connect · Discover · Experience</div></footer>
</main>

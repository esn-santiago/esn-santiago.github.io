---
import { getDictionary, langPrefix, defaultLang, type LanguageCode, type PageSlug } from '../i18n';
import SiteFooter from './SiteFooter.astro';

const { lang = defaultLang } = Astro.props as { lang?: LanguageCode };
const dict = getDictionary(lang);
const { home } = dict;
const prefix = langPrefix(lang);
const path = (slug: string) => `${prefix}/${slug}`;

const committeeSlugs: PageSlug[] = [
  'actividades-deportivas',
  'actividades-sociales',
  'actividades-culturales',
  'fiestas',
  'viajes',
];
---

<main class="home-container">
  <section class="hero">
    <div class="hero-highlight">
      <div class="hero-highlight-inner home-container">
        <div class="hero-labels">
          <div class="hero-label"><span class="hero-dot"></span>SANTIAGO DE COMPOSTELA</div>
          <div class="hero-label"><span class="hero-dot"></span>LUGO</div>
        </div>

        <h1>{home.heroTitle[0]}<br /><span>{home.heroTitle[1]}</span><br />{home.heroTitle[2]}</h1>

        <div class="hero-bottom">
          <p>{home.heroText}</p>
          <div class="hero-actions">
            <a href={path('eventos')} class="brutalist-button button-dark">{home.heroCtaEvents}</a>
            <a href={path('about')} class="text-link">{home.heroCtaAbout}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="stats">
    {home.committees.map((committee, index) => (
      <a href={path(committeeSlugs[index])} class="stat"><strong>{committee}</strong></a>
    ))}
  </section>

  <section id="about" class="section">
    <div class="two-columns">
      <h2>{home.about.heading[0]}<br />{home.about.heading[1]}</h2>
      <div class="section-text">
        <p class="large-text">{home.about.leadBefore}<strong>{home.about.leadStrong}</strong>{home.about.leadAfter}</p>
        <p>{home.about.paragraphs[0]}</p>
        <p>{home.about.paragraphs[1]}</p>
      </div>
    </div>
  </section>

  <section id="activities" class="section">
    <div class="section-header">
      <h2>{home.activities.heading[0]}<br />{home.activities.heading[1]}</h2>
    </div>
    <div class="card-grid">
      {home.activities.cards.map((card, index) => (
        <article class="brutalist-card">
          <div class="card-icon">{card.icon}</div>
          <div class="card-number">0{index + 1}</div>
          <h3>{card.title}</h3>
          <p>{card.text}</p>
          <a href={path(card.href)}>{card.cta}</a>
        </article>
      ))}
    </div>
  </section>

  <section id="join" class="join-section">
    <div class="join-content">
      <h2>{home.join.heading}<br /><strong>{home.join.emphasis}</strong></h2>
      <p>{home.join.text}</p>
      <a href={path('contacto')} class="brutalist-button button-pink">{home.join.cta}</a>
    </div>
    <div class="join-decoration" aria-hidden="true"><span>ESN</span><span>SANTIAGO</span></div>
  </section>

  <section id="contact" class="contact-section">
    <div>
      <h2>{home.contact.heading}</h2>
      <p>{home.contact.text}</p>
    </div>
    <div class="contact-links">
      <a href="https://www.instagram.com/esn_santiagodecompostela/?hl=es" target="_blank" rel="noopener noreferrer">{home.contact.instagram} <span>↗</span></a>
      <a href="mailto:junta@esn-santiago.org">{home.contact.email} <span>↗</span></a>
      <a href={path('esncard')}>{home.contact.esncard} <span>↗</span></a>
    </div>
  </section>

  <SiteFooter lang={lang} />
</main>

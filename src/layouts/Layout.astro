---
import '../styles/global.css';
import { languageCodes, defaultLang, localizedPath, type LanguageCode } from '../i18n';

const {
  title = 'ESN Santiago de Compostela — Erasmus Student Network',
  description = 'ESN Santiago de Compostela. Connect, Discover, Experience. Comunidad internacional, voluntariado, actividades y experiencias Erasmus.',
  lang = defaultLang,
} = Astro.props as { title?: string; description?: string; lang?: LanguageCode };

const siteUrl = 'https://esn-santiago.github.io';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>

    <meta name="description" content={description} />

    <meta
      name="keywords"
      content="ESN Santiago, Erasmus Santiago de Compostela, Erasmus Student Network, estudiantes internacionales, Galicia, voluntariado"
    />

    <meta name="author" content="ESN Santiago de Compostela" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />

    <meta property="og:url" content={`${siteUrl}/`} />

    <meta property="og:title" content={title} />

    <meta property="og:description" content={description} />

    <meta property="og:image" content={`${siteUrl}/meta-1.png`} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="twitter:title" content={title} />

    <meta name="twitter:description" content={description} />

    <meta name="twitter:image" content={`${siteUrl}/meta-1.png`} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" />

    <!-- Theme -->
    <meta name="theme-color" content="#00AEEF" />

    <!-- Language alternatives -->
    {languageCodes.map((code) => <link rel="alternate" hreflang={code} href={`${siteUrl}${localizedPath(code)}`} />)}

    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${localizedPath(defaultLang)}`} />
  </head>

  <body>
    <slot />
  </body>
</html>

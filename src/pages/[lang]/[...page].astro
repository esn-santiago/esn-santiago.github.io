---
import Layout from '../../layouts/Layout.astro';
import SiteNavigation from '../../components/SiteNavigation.astro';
import { languages, pages, pageContent, type LanguageCode, type PageSlug } from '../../data/site';
export function getStaticPaths() {
  const langs = ['es', 'en', 'gl', 'fr', 'de', 'pt', 'it'];
  const routes = ['que-es-esn', 'erasmus-tips', 'esncard', 'eventos', 'blog', 'contacto', 'descuentos/locales', 'descuentos/nacionales', 'descuentos/internacionales'];
  return langs.flatMap((lang) => routes.map((page) => ({ params: { lang, page } })));
}
const lang = Astro.params.lang as LanguageCode;
const page = Astro.params.page as PageSlug;
const content = pageContent(lang, page);
---
<Layout title={`${content.title} — ESN Santiago`}><SiteNavigation {lang} /><main class="site-container content-page"><span class="section-number">ESN SANTIAGO · {languages[lang]}</span><h1>{content.title}</h1><p>{content.text}</p>{page === 'esncard' && <iframe title="ESNcard request" frameborder="0" scrolling="yes" src="https://eventupp.eu/iframes/student-request/spain" style="min-height: 700px; overflow-y: scroll; width: 100%;"></iframe>}<a class="brutalist-button button-blue" href={`/${lang}/`}>Back to home</a></main></Layout>

---
import Layout from '../layouts/Layout.astro';
import SiteNavigation from '../components/SiteNavigation.astro';
import { defaultLang, pageSlugs, getDictionary, type PageSlug } from '../i18n';

export function getStaticPaths() {
  return pageSlugs.map((slug) => ({ params: { slug } }));
}

const lang = defaultLang;
const slug = Astro.params.slug as PageSlug;
const dict = getDictionary(lang);
const content = dict.pages[slug];
---

<Layout lang={lang} title={`${content.title} — ESN Santiago`}>
  <SiteNavigation lang={lang} />
  <main class="site-container content-page">
    <h1>{content.title}</h1>
    <p>{content.text}</p>
    {slug === 'esncard' && (
      <iframe
        title="Solicitud ESNcard"
        frameborder="0"
        scrolling="yes"
        src="https://eventupp.eu/iframes/student-request/spain"
        style="min-height: 700px; overflow-y: scroll; width: 100%;"
      />
    )}
  </main>
</Layout>

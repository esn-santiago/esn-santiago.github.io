---
import Layout from '../../layouts/Layout.astro';
import SiteNavigation from '../../components/SiteNavigation.astro';
import { pageContent, type PageSlug } from '../../data/site';

export function getStaticPaths() {
  return ['locales', 'nacionales', 'internacionales'].map((page) => ({ params: { page } }));
}
const page = `descuentos/${Astro.params.page}` as PageSlug;
const content = pageContent('es', page);
---

<Layout title={`${content.title} — ESN Santiago`}>
  <SiteNavigation lang="es" />
  <main class="site-container content-page">
    <span class="section-number">ESN SANTIAGO</span>
    <h1>{content.title}</h1>
    <p>{content.text}</p>
    <a class="brutalist-button button-blue" href="/">Volver al inicio</a>
  </main>
</Layout>

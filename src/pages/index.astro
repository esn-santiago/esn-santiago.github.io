---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

import esnLogo from '../assets/esn-santiago-logo.png';
---

<Layout
  title="ESN Santiago de Compostela — Erasmus Student Network"
  description="Connect, Discover, Experience. ESN Santiago de Compostela, comunidad internacional para estudiantes Erasmus y estudiantes locales."
>
  <!-- =====================================================
       BARRA SUPERIOR ESN — ANCHO COMPLETO
  ====================================================== -->

  <div class="esn-color-bar" aria-hidden="true">
    <span class="esn-blue"></span>
    <span class="esn-pink"></span>
    <span class="esn-green"></span>
    <span class="esn-orange"></span>
    <span class="esn-blue"></span>
    <span class="esn-pink"></span>
    <span class="esn-green"></span>
    <span class="esn-orange"></span>
    <span class="esn-blue"></span>
    <span class="esn-pink"></span>
    <span class="esn-green"></span>
    <span class="esn-orange"></span>
  </div>

  <!-- =====================================================
       HEADER — ANCHO COMPLETO
  ====================================================== -->

  <header class="site-header">
    <div class="site-header-inner">
      <!-- LOGO -->

      <a href="/" class="brand">
        <Image src={esnLogo} alt="ESN Santiago de Compostela" class="brand-logo" />
      </a>

      <!-- =================================================
           NAVEGACIÓN DESKTOP
      ================================================== -->

      <nav class="desktop-nav" aria-label="Navegación principal">
        <a href="/que-es-esn"> ¿Qué es ESN? </a>

        <a href="/erasmus-tips"> Erasmus Tips </a>

        <a href="/esncard"> ESNcard </a>

        <a href="/eventos"> Eventos </a>

        <!-- DESCUENTOS -->

        <div class="nav-dropdown">
          <button class="nav-dropdown-trigger" type="button" aria-expanded="false">
            <span>Descuentos</span>
          </button>

          <div class="nav-dropdown-menu">
            <a href="/descuentos/locales">
              <strong>Descuentos locales</strong>
            </a>

            <a href="/descuentos/nacionales">
              <strong>Descuentos nacionales</strong>
            </a>

            <a href="/descuentos/internacionales">
              <strong>Descuentos internacionales</strong>
            </a>
          </div>
        </div>

        <a href="/blog"> Blog </a>

        <a href="/contacto"> Contacto </a>

        <label class="language-switcher">
          <span class="sr-only">Idioma</span>
          <select data-language-select aria-label="Seleccionar idioma">
            <option value="/es/" selected>Español</option>
            <option value="/en/">English</option>
            <option value="/gl/">Galego</option>
            <option value="/fr/">Français</option>
            <option value="/de/">Deutsch</option>
            <option value="/pt/">Português</option>
            <option value="/it/">Italiano</option>
          </select>
        </label>
      </nav>

      <!-- =================================================
           BOTÓN HAMBURGUESA
      ================================================== -->

      <button
        class="mobile-menu-button"
        id="mobile-menu-button"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </header>

  <!-- =====================================================
       LÍNEA INFERIOR — ANCHO COMPLETO
  ====================================================== -->

  <div class="header-bottom-line"></div>

  <!-- =====================================================
       MENÚ MÓVIL
  ====================================================== -->

  <nav id="mobile-menu" class="mobile-menu" aria-label="Navegación móvil">
    <a href="/que-es-esn"> ¿Qué es ESN? </a>

    <a href="/erasmus-tips"> Erasmus Tips </a>

    <a href="/esncard"> ESNcard </a>

    <a href="/eventos"> Eventos </a>

    <!-- DESCUENTOS -->

    <div class="mobile-menu-group">
      <button
        class="mobile-submenu-trigger"
        type="button"
        id="mobile-discounts-button"
        aria-expanded="false"
        aria-controls="mobile-discounts-menu"
      >
        <span>Descuentos</span>

        <span class="mobile-submenu-icon"> + </span>
      </button>

      <div class="mobile-submenu" id="mobile-discounts-menu">
        <a href="/descuentos/locales">
          Descuentos locales
        </a>

        <a href="/descuentos/nacionales">
          Descuentos nacionales
        </a>

        <a href="/descuentos/internacionales">
          Descuentos internacionales
        </a>
      </div>
    </div>

    <a href="/blog"> Blog </a>

    <a href="/contacto"> Contacto </a>

    <div class="mobile-language-list">
      <span>Idioma</span>
      <a href="/es/" aria-current="page">Español</a>
      <a href="/en/">English</a>
      <a href="/gl/">Galego</a>
      <a href="/fr/">Français</a>
      <a href="/de/">Deutsch</a>
      <a href="/pt/">Português</a>
      <a href="/it/">Italiano</a>
    </div>
  </nav>

  <!-- =====================================================
       CONTENIDO PRINCIPAL
  ====================================================== -->

  <main class="site-container">
    <!-- =================================================
         HERO
    ================================================== -->

    <section class="hero">
      <div class="hero-label">
        <span class="hero-dot"></span>

        SANTIAGO DE COMPOSTELA · GALICIA
      </div>

      <h1>
        Connect.
        <br />

        <span>Discover.</span>
        <br />

        Experience.
      </h1>

      <div class="hero-bottom">
        <p>
          ESN Santiago de Compostela conecta estudiantes internacionales y locales a través de experiencias,
          voluntariado, cultura y comunidad.
        </p>

        <div class="hero-actions">
          <a href="/eventos" class="brutalist-button button-pink"> VER EVENTOS → </a>

          <a href="/que-es-esn" class="text-link"> Conoce ESN → </a>
        </div>
      </div>

      <!-- BARRA DE COLORES -->

      <div class="hero-color-blocks" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>
    </section>

    <!-- =================================================
         STATS
    ================================================== -->

    <section class="stats">
      <div class="stat">
        <strong>ESN</strong>

        <span> International Community </span>
      </div>

      <div class="stat">
        <strong>🌍</strong>

        <span> Estudiantes internacionales </span>
      </div>

      <div class="stat">
        <strong>🤝</strong>

        <span> Voluntariado y comunidad </span>
      </div>

      <div class="stat">
        <strong>📍</strong>

        <span> Santiago de Compostela </span>
      </div>
    </section>

    <!-- =================================================
         ABOUT
    ================================================== -->

    <section id="about" class="section">
      <div class="section-header">
        <div class="section-number">01 / SOBRE ESN</div>

        <h2>
          Una comunidad
          <br />
          sin fronteras.
        </h2>
      </div>

      <div class="two-columns">
        <div></div>

        <div class="section-text">
          <p class="large-text">
            ESN Santiago de Compostela forma parte de
            <strong>Erasmus Student Network</strong>, una red internacional creada por y para estudiantes.
          </p>

          <p>
            Nuestra misión es ayudar a estudiantes internacionales a integrarse, descubrir Santiago y Galicia y
            construir conexiones que vayan más allá de la universidad.
          </p>

          <p>Lo hacemos mediante actividades culturales, eventos, voluntariado, viajes y experiencias compartidas.</p>
        </div>
      </div>
    </section>

    <!-- =================================================
         ACTIVIDADES
    ================================================== -->

    <section id="activities" class="section">
      <div class="section-header">
        <div class="section-number">02 / QUÉ HACEMOS</div>

        <h2>
          Descubre
          <br />
          ESN.
        </h2>
      </div>

      <div class="card-grid">
        <article class="brutalist-card">
          <div class="card-icon">🌍</div>

          <div class="card-number">01</div>

          <h3>International</h3>

          <p>Conoce estudiantes de todo el mundo y forma parte de una comunidad internacional en Santiago.</p>

          <a href="/que-es-esn"> Descubrir → </a>
        </article>

        <article class="brutalist-card">
          <div class="card-icon">🎉</div>

          <div class="card-number">02</div>

          <h3>Events</h3>

          <p>Fiestas, actividades culturales, deporte, encuentros y experiencias para compartir.</p>

          <a href="/eventos"> Ver eventos → </a>
        </article>

        <article class="brutalist-card">
          <div class="card-icon">🤝</div>

          <div class="card-number">03</div>

          <h3>Volunteering</h3>

          <p>Participa como voluntario y ayuda a construir una experiencia Erasmus mejor para todos.</p>

          <a href="/contacto"> Participar → </a>
        </article>
      </div>
    </section>

    <!-- =================================================
         EVENTOS
    ================================================== -->

    <section id="events" class="section">
      <div class="section-header events-header">
        <div>
          <div class="section-number">03 / AGENDA</div>

          <h2>
            Próximos
            <br />
            eventos.
          </h2>
        </div>

        <a href="/eventos" class="text-link"> Ver todos → </a>
      </div>

      <div class="events-list">
        <article class="event-row">
          <div class="event-date">
            <span>SEP</span>

            <strong>01</strong>
          </div>

          <div class="event-info">
            <span class="event-category"> WELCOME </span>

            <h3>Welcome Event</h3>

            <p>Conoce ESN Santiago y a otros estudiantes internacionales.</p>
          </div>

          <div class="event-location">📍 Santiago</div>

          <a href="/eventos" class="event-arrow" aria-label="Ver Welcome Event"> ↗ </a>
        </article>

        <article class="event-row">
          <div class="event-date">
            <span>OCT</span>

            <strong>10</strong>
          </div>

          <div class="event-info">
            <span class="event-category"> CULTURE </span>

            <h3>Cultural Exchange</h3>

            <p>Una experiencia para compartir culturas, idiomas y tradiciones.</p>
          </div>

          <div class="event-location">📍 Santiago</div>

          <a href="/eventos" class="event-arrow" aria-label="Ver Cultural Exchange"> ↗ </a>
        </article>

        <article class="event-row">
          <div class="event-date">
            <span>OCT</span>

            <strong>24</strong>
          </div>

          <div class="event-info">
            <span class="event-category"> TRAVEL </span>

            <h3>Discover Galicia</h3>

            <p>Descubre Galicia junto a nuestra comunidad internacional.</p>
          </div>

          <div class="event-location">📍 Galicia</div>

          <a href="/eventos" class="event-arrow" aria-label="Ver Discover Galicia"> ↗ </a>
        </article>
      </div>
    </section>

    <!-- =================================================
         JOIN
    ================================================== -->

    <section id="join" class="join-section">
      <div class="join-content">
        <div class="section-number">04 / PARTICIPA</div>

        <h2>
          No seas
          <br />

          <strong> un espectador. </strong>
        </h2>

        <p>
          Únete a ESN Santiago. Conoce gente, descubre Galicia, participa en actividades y ayuda a otros estudiantes
          internacionales.
        </p>

        <a href="/contacto" class="brutalist-button button-pink"> QUIERO PARTICIPAR → </a>
      </div>

      <div class="join-decoration">
        <span>ESN</span>

        <span>SANTIAGO</span>
      </div>
    </section>

    <!-- =================================================
         LANGUAGES
    ================================================== -->

    <section class="languages">
      <div>
        <span class="section-number"> 05 / IDIOMAS </span>

        <h2>
          Un espacio
          <br />

          para todos.
        </h2>
      </div>

      <div class="language-list">
        <a href="/es/">
          <span>🇪🇸</span>
          Español
        </a>

        <a href="/gl/">
          <span>🇬🇱</span>
          Galego
        </a>

        <a href="/en/">
          <span>🇬🇧</span>
          English
        </a>
      </div>
    </section>

    <!-- =================================================
         CONTACT
    ================================================== -->

    <section id="contact" class="contact-section">
      <div>
        <div class="section-number">06 / CONTACTO</div>

        <h2>¿Hablamos?</h2>

        <p>¿Eres estudiante internacional? ¿Quieres colaborar con ESN? ¿Tienes una propuesta?</p>
      </div>

      <div class="contact-links">
        <a href="#">
          Instagram
          <span>↗</span>
        </a>

        <a href="#">
          Email
          <span>↗</span>
        </a>

        <a href="/esncard">
          ESNcard
          <span>↗</span>
        </a>
      </div>
    </section>

    <!-- =================================================
         FOOTER
    ================================================== -->

    <footer class="site-footer">
      <div>
        <strong> ESN SANTIAGO </strong>

        <p>
          Erasmus Student Network
          <br />
          Santiago de Compostela · Galicia
        </p>
      </div>

      <div class="footer-right">
        <div class="footer-languages">ES · GL · EN</div>

        <div>Connect · Discover · Experience</div>
      </div>
    </footer>
  </main>

  <!-- =====================================================
       JAVASCRIPT
  ====================================================== -->

  <script>
    /* =================================================
       MENÚ PRINCIPAL MÓVIL
    ================================================== */

    const menuButton = document.getElementById('mobile-menu-button');

    const mobileMenu = document.getElementById('mobile-menu');

    menuButton?.addEventListener('click', () => {
      const isOpen = mobileMenu?.classList.toggle('is-open');

      menuButton.classList.toggle('is-open', !!isOpen);

      menuButton.setAttribute('aria-expanded', String(!!isOpen));

      menuButton.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
    });

    /* =================================================
       SUBMENÚ DESCUENTOS DESKTOP
    ================================================== */

    const dropdownTrigger = document.querySelector('.nav-dropdown-trigger');

    const dropdown = document.querySelector('.nav-dropdown');

    dropdownTrigger?.addEventListener('click', () => {
      const isOpen = dropdown?.classList.toggle('is-open');

      dropdownTrigger.setAttribute('aria-expanded', String(!!isOpen));
    });

    /* =================================================
       CERRAR DROPDOWN AL HACER CLICK FUERA
    ================================================== */

    document.addEventListener('click', (event) => {
      const target = event.target as Node;

      if (dropdown && !dropdown.contains(target)) {
        dropdown.classList.remove('is-open');

        dropdownTrigger?.setAttribute('aria-expanded', 'false');
      }
    });

    /* =================================================
       SUBMENÚ DESCUENTOS MÓVIL
    ================================================== */

    const mobileDiscountsButton = document.getElementById('mobile-discounts-button');

    const mobileDiscountsMenu = document.getElementById('mobile-discounts-menu');

    mobileDiscountsButton?.addEventListener('click', () => {
      const isOpen = mobileDiscountsMenu?.classList.toggle('is-open');

      mobileDiscountsButton.setAttribute('aria-expanded', String(!!isOpen));

      const icon = mobileDiscountsButton.querySelector('.mobile-submenu-icon');

      if (icon) {
        icon.textContent = isOpen ? '−' : '+';
      }
    });

    /* =================================================
       CERRAR MENÚ MÓVIL AL NAVEGAR
    ================================================== */

    mobileMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.remove('is-open');

        menuButton?.classList.remove('is-open');

        menuButton?.setAttribute('aria-expanded', 'false');

        menuButton?.setAttribute('aria-label', 'Abrir menú');
      });
    });

    document.querySelectorAll<HTMLSelectElement>('[data-language-select]').forEach((select) => {
      select.addEventListener('change', () => {
        window.location.href = select.value;
      });
    });
  </script>
</Layout>

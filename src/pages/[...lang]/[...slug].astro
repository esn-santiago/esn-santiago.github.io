---
import Layout from '../../layouts/Layout.astro';
import SiteNavigation from '../../components/SiteNavigation.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PaymentMethods from '../../components/PaymentMethods.astro';
import UpcomingEvents from '../../components/UpcomingEvents.astro';
import SocialStrips from '../../components/SocialStrips.astro';
import { languageCodes, defaultLang, pageSlugs, getDictionary, activityPageColors, whatsappGroupUrl, instagramUrl, type LanguageCode, type PageSlug } from '../../i18n';

export function getStaticPaths() {
  return languageCodes
    .filter((code) => code !== defaultLang)
    .flatMap((code) => pageSlugs.map((slug) => ({ params: { lang: code, slug } })));
}

const lang = Astro.params.lang as LanguageCode;
const slug = Astro.params.slug as PageSlug;
const dict = getDictionary(lang);
const content = dict.pages[slug];
const activityColor = activityPageColors[slug];

const readMoreLabels: Record<LanguageCode, string> = {
  es: 'Más información →',
  en: 'Read more →',
  gl: 'Máis información →',
  fr: "Plus d'informations →",
  de: 'Mehr erfahren →',
  pt: 'Mais informações →',
  it: 'Maggiori informazioni →',
};

function parsePostBlocks(text: string) {
  return text.split('\n\n').map((block) => {
    const lines = block.split('\n');
    if (lines.every((line) => line.trim().startsWith('- '))) {
      return { type: 'list' as const, items: lines.map((line) => line.trim().slice(2)) };
    }
    return { type: 'paragraph' as const, text: block };
  });
}
---

<Layout lang={lang} title={`${content.title} — ESN Santiago`}>
  <SiteNavigation lang={lang} />
  <main class={activityColor ? 'activity-page' : undefined}>
    {activityColor && (
      <div class="activity-hero" style={`background: ${activityColor};`}>
        <h1>{content.title}</h1>
      </div>
    )}
    <div class="site-container content-page">
    {!activityColor && <h1>{content.title}</h1>}
    <p>{content.text}</p>
    {(slug === 'eventos-mes-santiago' || slug === 'eventos-mes-lugo') && (
      <p class="events-month-note">
        {dict.eventsMonthNote.before}
        <a href={whatsappGroupUrl} target="_blank" rel="noopener noreferrer" class="events-month-note-link">{dict.eventsMonthNote.whatsappLabel}</a>
        {dict.eventsMonthNote.middle}
        <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class="events-month-note-link">{dict.eventsMonthNote.instagramLabel}</a>
        {dict.eventsMonthNote.after}
      </p>
    )}
    {slug === 'eventos' && content.cta && (
      <a href="/events-frame" target="_blank" rel="noopener noreferrer" class="brutalist-button button-orange page-cta">{content.cta}</a>
    )}
    {slug === 'eventos' && (
      <div class="city-events-grid">
        <a href={`/${lang}/eventos-mes-santiago`} class="city-events-card">
          <img src="/events/santiago.jpeg" alt="Eventos del mes en Santiago" loading="lazy" />
        </a>
        <a href={`/${lang}/eventos-mes-lugo`} class="city-events-card">
          <img src="/events/lugo.jpeg" alt="Eventos del mes en Lugo" loading="lazy" />
        </a>
      </div>
    )}
    {slug === 'eventos-mes-santiago' && <UpcomingEvents lang={lang} city="santiago" />}
    {slug === 'eventos-mes-lugo' && <UpcomingEvents lang={lang} city="lugo" />}
    {(slug === 'eventos-mes-santiago' || slug === 'eventos-mes-lugo') && dict.pages.eventos.cta && (
      <a href="/events-frame" target="_blank" rel="noopener noreferrer" class="brutalist-button button-orange page-cta">{dict.pages.eventos.cta}</a>
    )}
    {slug === 'esncard' && content.cta && (
      <a href="/esncard-form" class="brutalist-button button-green page-cta">{content.cta}</a>
    )}
    {slug === 'contacto' && <SocialStrips />}
    {content.body && (
      <div class="legal-content">
        {content.body.map((block) =>
          block.type === 'heading' ? (
            block.level === 2 ? <h2>{block.text}</h2> : <h3>{block.text}</h3>
          ) : block.type === 'list' ? (
            <ul>
              {block.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          ) : (
            <p>{block.text}</p>
          )
        )}
      </div>
    )}
    {slug === 'metodos-de-pago' && <PaymentMethods />}
    {content.posts && (
      <div class="blog-posts">
        {content.posts.map((post) => (
          <article class={`blog-post${post.accent === 'pink' ? ' blog-post-pink' : ''}`}>
            {post.date && <time class="blog-post-date">{post.date}</time>}
            {post.title && (
              <h2 class={post.accent === 'pink' ? 'blog-post-title-banner' : undefined}>
                {post.slug ? <a href={`/${lang}/blog/${post.slug}`} class="blog-post-title-link">{post.title}</a> : post.title}
              </h2>
            )}
            {parsePostBlocks(post.text).map((block) =>
              block.type === 'list' ? (
                <ul>
                  {block.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              ) : (
                <p>{block.text}</p>
              )
            )}
            {post.link && (
              <a class="blog-post-link" href={post.link} target="_blank" rel="noopener noreferrer">
                {post.linkText ?? readMoreLabels[lang]}
              </a>
            )}
          </article>
        ))}
      </div>
    )}
    </div>
  </main>
  <SiteFooter lang={lang} />
</Layout>
